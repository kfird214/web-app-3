<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= pageTitle %></title>

<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

<style type="text/tailwindcss">
  /* The palette, once. Every colour utility in the markup comes from here. */
  @theme {
    --color-ink: #0d1117;
    --color-inksoft: #151b23;
    --color-panel: #161d26;
    --color-panel2: #1c2530;
    --color-line: #263141;
    --color-txt: #e6edf3;
    --color-muted: #8b98a8;
    --color-accent: #6ea8fe;
    --color-mint: #7ee2c0;
    --color-ok: #3fb950;
    --color-warn: #e3b341;
    --color-err: #f85149;
  }

  /* Only the pieces that repeat, or that the client script has to build by hand.
     Everything else is plain utilities in the markup. */
  @layer components {
    .chip {
      @apply rounded-full border border-line bg-panel2 px-3 py-1 text-xs text-muted no-underline;
    }
    .chip-action { @apply cursor-pointer hover:border-accent hover:text-txt; }

    .btn {
      @apply cursor-pointer rounded-lg border border-line bg-panel px-3.5 py-2 text-sm font-semibold
             text-txt hover:border-accent disabled:cursor-not-allowed;
    }

    .input {
      @apply min-w-0 rounded-lg border border-line bg-panel px-2.5 py-2 font-mono text-sm text-txt
             focus:outline-2 focus:-outline-offset-1 focus:outline-accent disabled:cursor-not-allowed;
    }

    .field { @apply rounded-xl border border-line bg-panel2 p-3.5; }
    .field legend { @apply px-1.5 text-xs tracking-widest text-muted uppercase; }

    .method {
      @apply cursor-pointer rounded-lg border border-line bg-panel px-3.5 py-2 font-mono text-sm
             font-semibold text-txt hover:border-accent disabled:cursor-not-allowed;
    }
    .method.is-active { @apply border-accent bg-accent text-ink; }

    .step {
      @apply size-9 cursor-pointer rounded-full border border-line bg-panel2 font-mono text-sm
             font-semibold text-muted hover:border-accent hover:text-txt;
    }
    .step-done { @apply border-ok bg-ok/15 text-ok; }
    .step-locked { @apply cursor-not-allowed opacity-40; }
    .step.is-current { @apply border-accent bg-accent text-ink; }

    .badge { @apply rounded-full px-2.5 py-0.5 font-mono text-xs font-bold whitespace-nowrap; }
    .badge-ok { @apply bg-ok/20 text-ok; }
    .badge-info { @apply bg-accent/20 text-accent; }
    .badge-err { @apply bg-err/20 text-err; }

    .verdict { @apply mb-3 rounded-lg px-3 py-2 text-sm; }
    .verdict-ok { @apply bg-ok/12 text-ok; }
    .verdict-no { @apply bg-err/10 text-[#ff9d96]; }
    .verdict-local { @apply bg-warn/12 text-warn; }

    .json {
      @apply m-0 max-h-[22rem] overflow-auto rounded-lg border border-line bg-ink p-3
             font-mono text-xs whitespace-pre;
    }
    .no-body {
      @apply m-0 rounded-lg border border-dashed border-line bg-ink p-3 text-sm text-muted;
    }

    .verb {
      @apply rounded border border-line bg-panel2 px-2 py-0.5 font-mono text-[0.72rem] font-bold;
    }
    .verb-get { @apply text-accent; }
    .verb-post { @apply text-ok; }
    .verb-put { @apply text-warn; }
    .verb-patch { @apply text-mint; }
    .verb-delete { @apply text-err; }
    .verb-reference { @apply text-muted; }
    .doc-table { @apply mt-3 w-full border-collapse text-xs; }
    .doc-table th {
      @apply border-b border-line px-2 py-1.5 text-left font-semibold text-muted;
    }
    .doc-table td { @apply border-b border-line px-2 py-1.5 align-top; }
  }
</style>

<link rel="stylesheet" href="/static/index.css" />
